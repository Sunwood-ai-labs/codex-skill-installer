{
  "name": "codex-skill-forge",
  "private": true,
  "version": "0.2.0",
  "description": "Cross-platform desktop app for reviewing and installing Codex skills from GitHub repositories.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sunwood-ai-labs/codex-skill-installer.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 4173",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 4173",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri"
  },
  "homepage": "https://sunwood-ai-labs.github.io/codex-skill-installer/",
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.2",
    "@types/node": "^24.12.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.0",
    "vue": "^3.5.13",
    "vitepress": "^1.6.4",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}
